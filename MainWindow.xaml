<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo"
    xmlns:views="using:Demo.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Demo">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>


    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Background="#80F0F0F0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="LeftDragColumn" Width="*" />
                <ColumnDefinition x:Name="RightDragColumn" Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SidebarToggleButton"
                        Margin="10.5,0,0,0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}">
                    <FontIcon Glyph="&#xE90C;"
                              FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Border Width="1"
                        Background="#40999999"
                        Margin="8,14,0,14" />
            </StackPanel>

            <TextBlock x:Name="TitleBarTextBlock"
                       Grid.Column="2"
                       Text="{x:Bind ViewModel.AppTitleText, Mode=OneWay}"
                       FontFamily="{StaticResource HarmonyOSRegular}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />

            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button x:Name="OpenButton"
                        Margin="0,0,4,0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{x:Bind ViewModel.Document.OpenCommand}">
                    <FontIcon Glyph="&#xE8E5;"
                              FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Button x:Name="ExportButton"
                        Margin="0,0,4,0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{x:Bind ViewModel.Document.ExportCommand}">
                    <FontIcon Glyph="&#xE898;"
                              FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Button x:Name="ThemeToggleButton"
                        Margin="0,0,4,0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleMarkdownThemeCommand}">
                    <FontIcon Glyph="&#xE790;"
                              FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Button x:Name="SettingsButton"
                        Margin="0,0,12,0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}">
                    <FontIcon Glyph="&#xE713;"
                              FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#40999999" />

        <Grid Grid.Row="2" Background="#B0FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" x:Name="contentArea">
                <views:MarkdownEditorView Document="{x:Bind ViewModel.Document}"
                                          IsDarkTheme="{x:Bind ViewModel.IsMarkdownDark, Mode=OneWay}" />
            </Grid>

            <Grid Grid.Column="0" x:Name="contentSpacer" Width="261" />

            <Grid x:Name="sidebarContainer" Width="261" HorizontalAlignment="Left" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="sidebarTransform" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="sidebarContent" Background="#B0FDFDFC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="12,12,12,4"
                            Background="Transparent"
                            BorderBrush="#60909090"
                            BorderThickness="1"
                            CornerRadius="6"
                            x:Name="searchBoxBorder">
                        <TextBox x:Name="searchBox"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind ViewModel.SearchBoxPlaceholder, Mode=OneWay}"
                                 FontFamily="{StaticResource HarmonyOSRegular}"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus" />
                    </Border>

                    <Grid Grid.Row="1" />
                </Grid>

                <Border Grid.Column="1"
                        x:Name="sidebarSeparator"
                        Width="1"
                        Background="#40999999"
                        Visibility="Visible" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#40999999" />

        <Grid Grid.Row="4" Height="32" Background="#B0FFFFFF" />

        <views:SettingsPage x:Name="settingsHost"
                             Grid.RowSpan="5" />
    </Grid>
</Window>
