<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Demo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Demo">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>


    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="47" Background="#80F0F0F0">
            <TitleBar x:Name="AppTitleBar"
                      Title="你好">
                <!--<TitleBar.IconSource>
                    <FontIconSource Glyph="&#xF4AA;"/>
                </TitleBar.IconSource>-->
                <TitleBar.LeftHeader>
                    <Button Margin="10.5,0,0,0"
                            Style="{StaticResource SidebarToggleButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}">
                        <FontIcon Glyph="&#xE90C;"
                                  FontSize="16"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </Button>
                </TitleBar.LeftHeader>
            </TitleBar>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#40999999" />

        <Grid Grid.Row="2" Background="#B0FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="261" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="sidebarContainer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="sidebarTransform" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="sidebarContent" Background="#B0FDFDFC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="12,12,12,4"
                            Background="Transparent"
                            BorderBrush="#60909090"
                            BorderThickness="1"
                            CornerRadius="6"
                            x:Name="searchBoxBorder">
                        <TextBox PlaceholderText="筛选文件"
                                 FontFamily="{StaticResource HarmonyOSRegular}"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus" />
                    </Border>

                    <Grid Grid.Row="1" />
                </Grid>

                <Border Grid.Column="1"
                        x:Name="sidebarSeparator"
                        Width="1"
                        Background="#40999999"
                        Visibility="Visible" />
            </Grid>

            <Grid Grid.Column="1" x:Name="contentArea">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="contentTransform" />
                </Grid.RenderTransform>
                <TextBlock Text="占位文字"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#80909090"
                           FontFamily="{StaticResource HarmonyOSRegular}"
                           FontSize="14" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#40999999" />

        <Grid Grid.Row="4" Height="32" Background="#B0FFFFFF" />
    </Grid>
</Window>
