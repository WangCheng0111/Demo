<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Demo.Views.ReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Demo.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid x:Name="emptyStateGrid"
              Background="Transparent"
              DoubleTapped="ContentEmptyHint_DoubleTapped"
              Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE8E5;"
                          FontSize="36"
                          Foreground="#80909090"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyHintText}"
                           FontFamily="{StaticResource HarmonyOSRegular}"
                           FontSize="14"
                           Foreground="#80909090"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ParsingText}"
                           FontFamily="{StaticResource HarmonyOSRegular}"
                           FontSize="13"
                           Foreground="#80909090"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Border x:Name="readerClipHost"
                CornerRadius="1"
                Background="Transparent"
                Visibility="{Binding HasCurrentBook, Converter={StaticResource BoolToVisibility}}">
            <ListView x:Name="readerView"
                      Visibility="{Binding HasCurrentBook, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{Binding Paragraphs}"
                      SelectionMode="None"
                      Background="Transparent"
                      Padding="24,12,24,24">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="Root">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver" />
                                            <VisualState x:Name="Pressed" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ReaderParagraph">
                    <Grid>
                        <TextBlock Text="{x:Bind Text}"
                                   FontFamily="{StaticResource HarmonyOSRegular}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,28,0,20"
                                   Visibility="{x:Bind IsTitle, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind Text}"
                                   FontFamily="{StaticResource HarmonyOSRegular}"
                                   FontSize="15"
                                   Foreground="#333333"
                                   LineHeight="28"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{x:Bind IsBody, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
